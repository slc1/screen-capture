<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ScreenCapture.Core.Localization"
        x:Class="ScreenCapture.App.Common.MessageWindow"
        Title="{Binding [App_Name], Source={x:Static loc:Loc.Instance}}"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <Button HorizontalAlignment="Right"
                MinWidth="80"
                IsDefault="True"
                HorizontalContentAlignment="Center"
                Content="{Binding [Common_OK], Source={x:Static loc:Loc.Instance}}"
                Click="OnOk" />
    </StackPanel>
</Window>
