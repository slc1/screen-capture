<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:ScreenCapture.Core.Localization"
        xmlns:core="using:ScreenCapture.Core.Editing"
        xmlns:ann="using:ScreenCapture.Core.Annotations"
        xmlns:common="using:ScreenCapture.App.Common"
        xmlns:editor="using:ScreenCapture.App.Editor"
        x:Class="ScreenCapture.App.Editor.EditorWindow"
        Title="{Binding [Editor_Title], Source={x:Static loc:Loc.Instance}}"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="Manual">
    <Window.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool.selected">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>
        <Style Selector="Button.tool Path">
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.swatch.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>
        <Style Selector="Button.widthOption">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.widthOption.selected">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        </Style>
        <Style Selector="Button.widthOption Path">
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="StrokeLineCap" Value="Flat" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.widthOption TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Rectangle.separator">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border x:Name="Toolbar"
                DockPanel.Dock="Top"
                Height="{x:Static editor:EditorWindow.ToolbarHeight}"
                Padding="6,0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <Button Content="{Binding [Editor_Save], Source={x:Static loc:Loc.Instance}}"
                            Command="{Binding SaveCommand}" />
                    <Button Classes="accent"
                            Content="{Binding [Editor_Copy], Source={x:Static loc:Loc.Instance}}"
                            Command="{Binding CopyCommand}" />
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Classes="tool"
                                Classes.selected="{Binding Tool, Converter={x:Static common:EqualsConverter.Instance}, ConverterParameter={x:Static core:EditorTool.Select}}"
                                Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:EditorTool.Select}"
                                ToolTip.Tip="{Binding [Tool_Select], Source={x:Static loc:Loc.Instance}}">
                            <Path Data="M6,3 L6,16 L9.5,12.5 L12,17.5 L13.8,16.6 L11.4,11.6 L16,11.6 Z" />
                        </Button>
                        <Button Classes="tool"
                                Classes.selected="{Binding Tool, Converter={x:Static common:EqualsConverter.Instance}, ConverterParameter={x:Static core:EditorTool.Arrow}}"
                                Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:EditorTool.Arrow}"
                                ToolTip.Tip="{Binding [Tool_Arrow], Source={x:Static loc:Loc.Instance}}">
                            <Path Data="M4,16 L15.5,4.5 M8.5,4.5 L15.5,4.5 L15.5,11.5" />
                        </Button>
                        <Button Classes="tool"
                                Classes.selected="{Binding Tool, Converter={x:Static common:EqualsConverter.Instance}, ConverterParameter={x:Static core:EditorTool.Line}}"
                                Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:EditorTool.Line}"
                                ToolTip.Tip="{Binding [Tool_Line], Source={x:Static loc:Loc.Instance}}">
                            <Path Data="M4,16 L16,4" />
                        </Button>
                        <Button Classes="tool"
                                Classes.selected="{Binding Tool, Converter={x:Static common:EqualsConverter.Instance}, ConverterParameter={x:Static core:EditorTool.Rectangle}}"
                                Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:EditorTool.Rectangle}"
                                ToolTip.Tip="{Binding [Tool_Rectangle], Source={x:Static loc:Loc.Instance}}">
                            <Path Data="M3,5 L17,5 L17,15 L3,15 Z" />
                        </Button>
                        <Button Classes="tool"
                                Classes.selected="{Binding Tool, Converter={x:Static common:EqualsConverter.Instance}, ConverterParameter={x:Static core:EditorTool.Marker}}"
                                Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:EditorTool.Marker}"
                                ToolTip.Tip="{Binding [Tool_Marker], Source={x:Static loc:Loc.Instance}}">
                            <Path Data="M4,13 L16,7" StrokeThickness="5" StrokeLineCap="Square" Opacity="0.6" />
                        </Button>
                        <Button Classes="tool"
                                Classes.selected="{Binding Tool, Converter={x:Static common:EqualsConverter.Instance}, ConverterParameter={x:Static core:EditorTool.Text}}"
                                Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:EditorTool.Text}"
                                ToolTip.Tip="{Binding [Tool_Text], Source={x:Static loc:Loc.Instance}}">
                            <Path Data="M4,4 L16,4 M10,4 L10,17" StrokeThickness="2" />
                        </Button>
                        <Button Classes="tool"
                                Classes.selected="{Binding Tool, Converter={x:Static common:EqualsConverter.Instance}, ConverterParameter={x:Static core:EditorTool.Blur}}"
                                Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:EditorTool.Blur}"
                                ToolTip.Tip="{Binding [Tool_Blur], Source={x:Static loc:Loc.Instance}}">
                            <Path Data="M3,3 L17,3 L17,17 L3,17 Z M3,10 L17,10 M10,3 L10,17" />
                        </Button>
                        <Button Classes="tool"
                                Classes.selected="{Binding Tool, Converter={x:Static common:EqualsConverter.Instance}, ConverterParameter={x:Static core:EditorTool.Recognize}}"
                                Command="{Binding SelectToolCommand}" CommandParameter="{x:Static core:EditorTool.Recognize}"
                                ToolTip.Tip="{Binding [Tool_Recognize], Source={x:Static loc:Loc.Instance}}">
                            <Path Data="M2,6 L2,2 L6,2 M14,2 L18,2 L18,6 M18,14 L18,18 L14,18 M6,18 L2,18 L2,14 M6.5,6.5 L13.5,6.5 M10,6.5 L10,14" />
                        </Button>

                        <Rectangle Classes="separator" />

                        <Button x:Name="ColorButton"
                                Classes="tool"
                                Width="40"
                                ToolTip.Tip="{Binding [Editor_Color], Source={x:Static loc:Loc.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Ellipse Width="18" Height="18" Fill="{Binding SelectedSwatch.Brush}"
                                         Stroke="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                         StrokeThickness="1" />
                                <Path Data="M0,0 L3.5,3.5 L7,0" Width="7" Height="4" StrokeThickness="1.4"
                                      VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ItemsControl ItemsSource="{Binding Swatches}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="swatch"
                                                        Classes.selected="{Binding IsSelected}"
                                                        Margin="2"
                                                        Command="{Binding $parent[ItemsControl].DataContext.SelectColorCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Ellipse Width="20" Height="20" Fill="{Binding Brush}"
                                                             Stroke="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                                             StrokeThickness="1" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Rectangle Classes="separator" />

                        <Button x:Name="WidthButton"
                                Classes="tool"
                                Width="40"
                                ToolTip.Tip="{Binding [Editor_Width], Source={x:Static loc:Loc.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Path Data="M0,10 L18,10" Width="18"
                                      StrokeLineCap="Flat"
                                      StrokeThickness="{Binding Width, Converter={x:Static editor:StrokePreviewConverter.Instance}}" />
                                <Path Data="M0,0 L3.5,3.5 L7,0" Width="7" Height="4" StrokeThickness="1.4"
                                      VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Spacing="2">
                                        <Button Classes="widthOption"
                                                Classes.selected="{Binding Width, Converter={x:Static common:EqualsConverter.Instance}, ConverterParameter={x:Static ann:StrokeWidth.ExtraThin}}"
                                                Command="{Binding SelectWidthCommand}" CommandParameter="{x:Static ann:StrokeWidth.ExtraThin}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Path Data="M0,10 L28,10" StrokeThickness="1" />
                                                <TextBlock Text="{Binding [Stroke_ExtraThin], Source={x:Static loc:Loc.Instance}}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="widthOption"
                                                Classes.selected="{Binding Width, Converter={x:Static common:EqualsConverter.Instance}, ConverterParameter={x:Static ann:StrokeWidth.Thin}}"
                                                Command="{Binding SelectWidthCommand}" CommandParameter="{x:Static ann:StrokeWidth.Thin}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Path Data="M0,10 L28,10" StrokeThickness="1.5" />
                                                <TextBlock Text="{Binding [Stroke_Thin], Source={x:Static loc:Loc.Instance}}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="widthOption"
                                                Classes.selected="{Binding Width, Converter={x:Static common:EqualsConverter.Instance}, ConverterParameter={x:Static ann:StrokeWidth.Medium}}"
                                                Command="{Binding SelectWidthCommand}" CommandParameter="{x:Static ann:StrokeWidth.Medium}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Path Data="M0,10 L28,10" StrokeThickness="2.5" />
                                                <TextBlock Text="{Binding [Stroke_Medium], Source={x:Static loc:Loc.Instance}}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="widthOption"
                                                Classes.selected="{Binding Width, Converter={x:Static common:EqualsConverter.Instance}, ConverterParameter={x:Static ann:StrokeWidth.Thick}}"
                                                Command="{Binding SelectWidthCommand}" CommandParameter="{x:Static ann:StrokeWidth.Thick}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Path Data="M0,10 L28,10" StrokeThickness="4" />
                                                <TextBlock Text="{Binding [Stroke_Thick], Source={x:Static loc:Loc.Instance}}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="widthOption"
                                                Classes.selected="{Binding Width, Converter={x:Static common:EqualsConverter.Instance}, ConverterParameter={x:Static ann:StrokeWidth.ExtraThick}}"
                                                Command="{Binding SelectWidthCommand}" CommandParameter="{x:Static ann:StrokeWidth.ExtraThick}">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Path Data="M0,10 L28,10" StrokeThickness="6" />
                                                <TextBlock Text="{Binding [Stroke_ExtraThick], Source={x:Static loc:Loc.Instance}}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Rectangle Classes="separator" />

                        <Button Classes="tool"
                                Command="{Binding UndoCommand}"
                                ToolTip.Tip="{Binding [Editor_Undo], Source={x:Static loc:Loc.Instance}}">
                            <Path Data="M7,5 L3,9 L7,13 M3,9 L12,9 A4.5,4.5 0 0 1 12,18 L8,18" />
                        </Button>
                        <Button Classes="tool"
                                Command="{Binding RedoCommand}"
                                ToolTip.Tip="{Binding [Editor_Redo], Source={x:Static loc:Loc.Instance}}">
                            <Path Data="M13,5 L17,9 L13,13 M17,9 L8,9 A4.5,4.5 0 0 0 8,18 L12,18" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Panel Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}">
            <editor:AnnotationCanvas x:Name="Surface" />
            <Canvas x:Name="TextLayer" />
        </Panel>
    </DockPanel>
</Window>
